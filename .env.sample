# Application
APP_PORT=8080
ADMIN_API_KEY=change-me
ADMIN_PASSWORD=change-me
# Long random value used to hash monthly visitors without storing raw IPs.
# Generate for example with: openssl rand -hex 32
ANALYTICS_SALT=change-to-a-long-random-value

# Tools (true enables, false disables creation pages and APIs)
TOOL_SHORTENER_ENABLED=true

# Backend selection: supabase|postgres
DB_DRIVER=supabase

# Supabase (required when DB_DRIVER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL (used when DB_DRIVER=postgres)
# POSTGRES_DSN=pgsql:host=localhost;port=5432;dbname=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Screenshot service (optional)
SCREENSHOTONE_ACCESS_KEY=

# Local paths (optional)
# ALLOWED_PROTOCOLS_FILE=/path/to/allowed_protocols.txt
